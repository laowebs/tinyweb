{
  "name": "TinyWeb DevContainer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bullseye",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.live-server",
        "esbenp.prettier-vscode"
      ]
    }
  },

  // 💡 ຄຳສັ່ງນີ້ຈະรันຕິດຕັ້ງ Surge ໃຫ້ອັດຕະໂນມັດທັນທີ ຫຼັງຈາກ Codespace ເປີດຂຶ້ນມາ
  "postCreateCommand": "npm install -g surge",

  "forwardPorts": [5500]
}
